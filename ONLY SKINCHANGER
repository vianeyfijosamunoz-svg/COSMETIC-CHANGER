local function formatAssetId(val)
    if not val then return nil end
    local str = tostring(val)
    if str:find("rbxasset") then
        return str
    elseif str:match("^%d+$") then
        return "rbxassetid://" .. str
    end
    return str
end

local function getAssetImage(targetName, isWeapon)
    if isWeapon and ItemLibrary and ItemLibrary.Items then
        local item = ItemLibrary.Items[targetName]
        if item then
            local raw = item.Image or item.Icon or item.Texture or item.TextureId
            local formatted = formatAssetId(raw)
            if formatted then return formatted end
        end
    elseif not isWeapon and CosmeticLibrary and CosmeticLibrary.Cosmetics then
        local cosmetic = CosmeticLibrary.Cosmetics[targetName]
        if cosmetic then
            local raw = cosmetic.Image or cosmetic.Icon or cosmetic.Thumbnail or cosmetic.Texture or cosmetic.TextureId
            local formatted = formatAssetId(raw)
            if formatted then return formatted end
        end
    end
    return "rbxassetid://6023426915"
end

local function isWeaponCosmetic(name, cosmetic)
    if not name then return false end
    local n = tostring(name):lower()
    local t = (cosmetic and tostring(cosmetic.Type or ""):lower()) or ""
    if t:find("finisher") or t:find("emote") or t:find("dance") or t:find("kill") then
        return false
    end
    if t == "skin" or t == "charm" or t == "wrap" or t == "wrapping" then
        return true
    end
    if n:find("skin") or n:find("charm") or n:find("wrap") then
        return true
    end
    if cosmetic and (cosmetic.Seed or cosmetic.ObjectID or cosmetic.Enum) then
        return true
    end
    return false
end

local function cloneCosmetic(name, cosmeticType)
    local base = CosmeticLibrary.Cosmetics[name]
    if not base then return nil end
    local data = {}
    for k, v in pairs(base) do
        data[k] = v
    end
    data.Name = name
    data.Type = data.Type or cosmeticType or "Skin"
    data.Seed = data.Seed or math.random(1, 999999)
    if EnumLibrary then
        local ok, enumId = pcall(function()
            return EnumLibrary:ToEnum(name)
        end)
        if ok and enumId then
            data.Enum = enumId
            data.ObjectID = data.ObjectID or enumId
        end
    end
    if data.Inverted == nil then data.Inverted = false end
    if data.OnlyUseFavorites == nil then data.OnlyUseFavorites = false end
    return data
end

local saveFile = "axe_skinchanger/config.json"

local function saveConfig()
    if not writefile then return end
    pcall(function()
        local config = {equipped = {}, favorites = favorites}
        for weapon, cosmetics in pairs(equipped) do
            config.equipped[weapon] = {}
            for ctype, cdata in pairs(cosmetics) do
                if cdata and cdata.Name then
                    config.equipped[weapon][ctype] = {name = cdata.Name, seed = cdata.Seed}
                end
            end
        end
        makefolder("axe_skinchanger")
        writefile(saveFile, HttpService:JSONEncode(config))
    end)
end

local function loadConfig()
    if not (readfile and isfile and isfile(saveFile)) then return end
    pcall(function()
        local config = HttpService:JSONDecode(readfile(saveFile))
        if config.equipped then
            for weapon, cosmetics in pairs(config.equipped) do
                equipped[weapon] = {}
                for ctype, cdata in pairs(cosmetics) do
                    local cloned = cloneCosmetic(cdata.name, ctype)
                    if cloned then
                        cloned.Seed = cdata.seed or cloned.Seed
                        equipped[weapon][ctype] = cloned
                    end
                end
            end
        end
        if config.favorites then
            favorites = config.favorites
        end
    end)
end

local originalOwns = CosmeticLibrary.OwnsCosmetic
CosmeticLibrary.OwnsCosmetic = function(self, inventory, name, weapon)
    if name:find("MISSING_") then
        return originalOwns(self, inventory, name, weapon)
    end
    local cosmetic = CosmeticLibrary.Cosmetics[name]
    if isWeaponCosmetic(name, cosmetic) then
        return true
    end
    return originalOwns(self, inventory, name, weapon)
end

for _, funcName in pairs({"OwnsCosmeticNormally", "OwnsCosmeticUniversally", "OwnsCosmeticForWeapon"}) do
    if CosmeticLibrary[funcName] then
        CosmeticLibrary[funcName] = function(_, _, name)
            local c = CosmeticLibrary.Cosmetics[name]
            return isWeaponCosmetic(name, c)
        end
    end
end

local originalGet = DataController.Get
DataController.Get = function(self, key)
    local data = originalGet(self, key)
    if key == "CosmeticInventory" then
        local proxy = {}
        for name, cosmetic in pairs(CosmeticLibrary.Cosmetics) do
            if isWeaponCosmetic(name, cosmetic) then
                proxy[name] = true
            end
        end
        return setmetatable(proxy, {
            __index = function(_, k)
                local c = CosmeticLibrary.Cosmetics[k]
                if isWeaponCosmetic(k, c) then
                    return true
                end
            end
        })
    end
    return data
end

local originalGetWeaponData = DataController.GetWeaponData
DataController.GetWeaponData = function(self, weaponName)
    local data = originalGetWeaponData(self, weaponName)
    if not data then return nil end
    local merged = {}
    for k, v in pairs(data) do
        merged[k] = v
    end
    merged.Name = weaponName
    if equipped[weaponName] then
        for ctype, cdata in pairs(equipped[weaponName]) do
            merged[ctype] = cdata
        end
    end
    return merged
end

