local function refreshCosmeticList(filter)
    for _, child in ipairs(ListFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local count = 0
    for name, cosmetic in pairs(CosmeticLibrary.Cosmetics) do
        if isWeaponCosmetic(name, cosmetic) then
            local typeMatch = false
            local t = tostring(cosmetic.Type or ""):lower()
            local n = name:lower()
            
            if currentCategory == "Skin" and (t == "skin" or n:find("skin")) then typeMatch = true end
            if currentCategory == "Charm" and (t == "charm" or n:find("charm")) then typeMatch = true end
            if currentCategory == "Wrap" and (t == "wrap" or t == "wrapping" or n:find("wrap")) then typeMatch = true end
            
            if typeMatch and (not filter or filter == "" or n:find(filter:lower())) then
                if not (showOnlyFavorites and not favorites[name]) then
                    count += 1
                    local btn = Instance.new("TextButton")
                    btn.Size = UDim2.new(0, 78, 0, 78)
                    btn.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
                    btn.BorderSizePixel = 0
                    btn.Text = ""
                    btn.AutoButtonColor = false
                    btn.Parent = ListFrame
                    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
                    local btnStroke = Instance.new("UIStroke")
                    btnStroke.Color = Color3.fromRGB(25, 25, 25)
                    btnStroke.Thickness = 1
                    btnStroke.Parent = btn
                    
                    local imgId = getAssetImage(name, false)
                    local icon = Instance.new("ImageLabel")
                    icon.Size = UDim2.new(1, -10, 1, -10)
                    icon.Position = UDim2.new(0, 5, 0, 5)
                    icon.BackgroundTransparency = 1
                    icon.Image = imgId
                    icon.ScaleType = Enum.ScaleType.Fit
                    icon.Parent = btn
                    
                    local nameLabel = Instance.new("TextLabel")
                    nameLabel.Size = UDim2.new(1, -4, 0, 12)
                    nameLabel.Position = UDim2.new(0, 2, 1, -14)
                    nameLabel.BackgroundTransparency = 1
                    nameLabel.Text = name
                    nameLabel.TextColor3 = Color3.fromRGB(170, 170, 170)
                    nameLabel.TextSize = 8
                    nameLabel.Font = Enum.Font.GothamBold
                    nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
                    nameLabel.TextXAlignment = Enum.TextXAlignment.Center
                    nameLabel.Parent = btn
                    
                    local star = Instance.new("TextButton")
                    star.Size = UDim2.new(0, 18, 0, 18)
                    star.Position = UDim2.new(1, -20, 0, 2)
                    star.BackgroundTransparency = 1
                    star.Text = (favorites[name] and "★") or "☆"
                    star.TextColor3 = (favorites[name] and Color3.fromRGB(255, 200, 50)) or Color3.fromRGB(100, 100, 100)
                    star.TextSize = 12
                    star.Font = Enum.Font.GothamBold
                    star.Parent = btn
                    
                    star.MouseButton1Click:Connect(function()
                        favorites[name] = not favorites[name]
                        if not favorites[name] then
                            favorites[name] = nil
                        end
                        star.Text = (favorites[name] and "★") or "☆"
                        star.TextColor3 = (favorites[name] and Color3.fromRGB(255, 200, 50)) or Color3.fromRGB(100, 100, 100)
                        saveConfig()
                    end)
                    
                    btn.MouseEnter:Connect(function()
                        TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(25, 25, 25)}):Play()
                        TweenService:Create(btnStroke, TweenInfo.new(0.12), {Color = Color3.fromRGB(60, 60, 60)}):Play()
                    end)
                    btn.MouseLeave:Connect(function()
                        TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(12, 12, 12)}):Play()
                        TweenService:Create(btnStroke, TweenInfo.new(0.12), {Color = Color3.fromRGB(25, 25, 25)}):Play()
                    end)
                    btn.MouseButton1Click:Connect(function()
                        equipCosmetic(name, currentCategory)
                        TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(0, 120, 60)}):Play()
                        task.wait(0.35)
                        TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(12, 12, 12)}):Play()
                    end)
                end
            end
        end
    end
    local rows = math.ceil(count / 8)
    ListFrame.CanvasSize = UDim2.new(0, 0, 0, (rows * 86) + 8)
end

local function refreshWeaponList(filter)
    for _, child in ipairs(WeaponList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local weapons = WEAPON_CATEGORIES[currentWeaponTab] or {}
    local count = 0
    for _, weaponName in ipairs(weapons) do
        if not filter or filter == "" or weaponName:lower():find(filter:lower()) then
            count += 1
            
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(0, 78, 0, 78)
            btn.BackgroundColor3 = (selectedWeapon == weaponName and Color3.fromRGB(25, 35, 45)) or Color3.fromRGB(12, 12, 12)
            btn.BorderSizePixel = 0
            btn.Text = ""
            btn.AutoButtonColor = false
            btn.Parent = WeaponList
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
            local btnStroke = Instance.new("UIStroke")
            btnStroke.Color = (selectedWeapon == weaponName and Color3.fromRGB(0, 150, 255)) or Color3.fromRGB(25, 25, 25)
            btnStroke.Thickness = 1
            btnStroke.Parent = btn
            
            local imgId = getAssetImage(weaponName, true)
            local icon = Instance.new("ImageLabel")
            icon.Size = UDim2.new(1, -10, 1, -10)
            icon.Position = UDim2.new(0, 5, 0, 5)
            icon.BackgroundTransparency = 1
            icon.Image = imgId
            icon.ScaleType = Enum.ScaleType.Fit
            icon.Parent = btn
            
            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, -4, 0, 12)
            nameLabel.Position = UDim2.new(0, 2, 1, -14)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = weaponName
            nameLabel.TextColor3 = Color3.fromRGB(170, 170, 170)
            nameLabel.TextSize = 8
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
            nameLabel.TextXAlignment = Enum.TextXAlignment.Center
            nameLabel.Parent = btn
            
            btn.MouseEnter:Connect(function()
                if selectedWeapon ~= weaponName then
                    TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(25, 25, 25)}):Play()
                    TweenService:Create(btnStroke, TweenInfo.new(0.12), {Color = Color3.fromRGB(60, 60, 60)}):Play()
                end
            end)
            btn.MouseLeave:Connect(function()
                if selectedWeapon ~= weaponName then
                    TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(12, 12, 12)}):Play()
                    TweenService:Create(btnStroke, TweenInfo.new(0.12), {Color = Color3.fromRGB(25, 25, 25)}):Play()
                end
            end)
            btn.MouseButton1Click:Connect(function()
                selectedWeapon = weaponName
                refreshWeaponList(WeaponSearch.Text)
                refreshCosmeticList(SearchBox.Text)
            end)
        end
    end
    local rows = math.ceil(count / 8)
    WeaponList.CanvasSize = UDim2.new(0, 0, 0, (rows * 86) + 8)
end

