end

local showNotify = function(text) end

local function equipCosmetic(name, ctype)
    if not selectedWeapon then return end
    equipped[selectedWeapon] = equipped[selectedWeapon] or {}
    local cloned = cloneCosmetic(name, ctype)
    if not cloned then return end
    equipped[selectedWeapon][ctype] = cloned
    forceUpdateWeapon(selectedWeapon)
    saveConfig()
    showNotify("✓ " .. name)

    task.delay(0.5, function()
        if equipped[selectedWeapon] and equipped[selectedWeapon][ctype] then
            local targetCosmetic = equipped[selectedWeapon][ctype]
            if EnumLibrary then
                pcall(function()
                    local newEnum = EnumLibrary:ToEnum(targetCosmetic.Name)
                    if newEnum then
                        targetCosmetic.Enum = newEnum
                        targetCosmetic.ObjectID = newEnum
                    end
                end)
            else
                targetCosmetic.ObjectID = math.random(1000, 999999)
            end
            forceUpdateWeapon(selectedWeapon)
        end
    end)
end

local function unequipCurrent()
    if not selectedWeapon then return end
    if equipped[selectedWeapon] then
        equipped[selectedWeapon][currentCategory] = nil
        if not next(equipped[selectedWeapon]) then
            equipped[selectedWeapon] = nil
        end
        forceUpdateWeapon(selectedWeapon)
        saveConfig()
        showNotify("Removido")
    end
end

local function randomSkin()
    if not selectedWeapon then return end
    local list = {}
    for name, cosmetic in pairs(CosmeticLibrary.Cosmetics) do
        if isWeaponCosmetic(name, cosmetic) then
            local t = tostring(cosmetic.Type or ""):lower()
            local n = name:lower()
            local match = false
            if currentCategory == "Skin" and (t == "skin" or n:find("skin")) then match = true end
            if currentCategory == "Charm" and (t == "charm" or n:find("charm")) then match = true end
            if currentCategory == "Wrap" and (t == "wrap" or t == "wrapping" or n:find("wrap")) then match = true end
            if match then
                table.insert(list, name)
            end
        end
    end
    if #list > 0 then
        equipCosmetic(list[math.random(1, #list)], currentCategory)
    end
end

if hookmetamethod then
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local dataRemotes = remotes and remotes:FindFirstChild("Data")
    local equipRemote = dataRemotes and dataRemotes:FindFirstChild("EquipCosmetic")
    if equipRemote then
        local old
        old = hookmetamethod(game, "__namecall", function(self, ...)
            if getnamecallmethod() ~= "FireServer" then
                return old(self, ...)
            end
            local args = {...}
            if self == equipRemote then
                local weaponName, cosmeticType, cosmeticName = args[1], args[2], args[3]
                if weaponName then
                    equipped[weaponName] = equipped[weaponName] or {}
                    if cosmeticName and cosmeticName ~= "None" and cosmeticName ~= "" then
                        local cloned = cloneCosmetic(cosmeticName, cosmeticType)
                        if cloned then
                            equipped[weaponName][cosmeticType] = cloned
                        end
                    else
                        equipped[weaponName][cosmeticType] = nil
                    end
                    task.defer(function()
                        forceUpdateWeapon(weaponName)
                        saveConfig()
                    end)
                end
                return
            end
            return old(self, ...)
        end)
    end
end

